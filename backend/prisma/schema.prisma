generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id                     String                   @id @default(uuid())
  email                  String                   @unique
  name                   String
  githubId               String?                  @unique
  linkedinId             String?                  @unique
  portfolioUrl           String?
  bio                    String?
  avatarUrl              String?
  skills                 Skill[]                  @relation("UserSkills")
  experience             Json?
  interests              String[]
  timeZone               String?
  availability           Json?
  teamMemberships        TeamMember[]
  progressUpdates        ProgressUpdate[]         @relation("UserProgressUpdates")
  aiRecommendations      AIRecommendation[]       @relation("UserRecommendations")
  tasksAssigned          Task[]                   @relation("TaskAssignee")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  githubStats            Json?
  comments               Comment[]
  Team                   Team[] // Teams this user leads or is part of
  RecommendationFeedback RecommendationFeedback[]
  GitHubContribution     GitHubContribution[]
  NotificationPreference NotificationPreference?
  Notification           Notification[]
  Mentorship             Mentorship[]
  mentorshipsGiven       Mentorship[]             @relation("MentorshipsGiven")
  mentorshipsReceived    Mentorship[]             @relation("MentorshipsReceived")
  EventLog               EventLog[]
  // CHANGED: Added hackathons relation to track user's hackathon participation
  hackathons             Hackathon[]              @relation("UserHackathons") // Through team membership

  gitHubAccessToken       String?         @db.Text
  gitHubRefreshToken      String?         @db.Text
  googleAccessToken       String?         @db.Text
  googleRefreshToken      String?         @db.Text
  verificationToken       String?
  verificationTokenExpiry DateTime?
  password                String?
  googleId                String?         @unique
  refreshToken            String?
  isEmailVerified         Boolean         @default(false)
  status                  String          @default("active")
  lastLogin               DateTime?
  aiInteractionPrefs      Json?
  ProjectMember           ProjectMember[]
}

model Skill {
  id       String    @id @default(uuid())
  name     String    @unique
  category String?
  users    User[]    @relation("UserSkills")
  teams    Team[]    @relation("TeamSkillsNeeded")
  projects Project[] @relation("ProjectTechnologies")
}

model Team {
  id                String       @id @default(uuid())
  name              String
  description       String?
  lookingForMembers Boolean      @default(false)
  skillsNeeded      Skill[]      @relation("TeamSkillsNeeded")
  members           TeamMember[]
  hackathon         Hackathon? // Each team creates one hackathon
  project           Project? // Each team has one project
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  leaderId          String
  leader            User         @relation(fields: [leaderId], references: [id])
  tasks             Task[]       @relation("TeamTasks")
}

model Hackathon {
  id           String              @id @default(uuid())
  teamId       String?             @unique
  team         Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  startDate    DateTime
  endDate      DateTime
  location     String?
  rules        String?
  prizeDetails Json?
  domains      String[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  aiInsights   Json?
  users        User[]              @relation("UserHackathons") // Users participating through teams
  // ADDED: Relation to timeline events
  timeline     HackathonTimeline[] @relation("HackathonTimeline")
}

model HackathonTimeline {
  id          String    @id @default(uuid())
  hackathonId String
  hackathon   Hackathon @relation("HackathonTimeline", fields: [hackathonId], references: [id], onDelete: Cascade)
  eventName   String // e.g., "Hackathon Start", "Mentoring Round 1", "Hackathon Ends"
  eventTime   DateTime // Specific date and time of the event
  description String? // Optional details about the event
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id                       String               @id @default(uuid())
  name                     String
  description              String?
  teamId                   String               @unique
  team                     Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks                    Task[]               @relation("ProjectTasks")
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  totalCommits             Int                  @default(0)
  totalPRs                 Int                  @default(0)
  totalIssues              Int                  @default(0)
  efficiencyScore          Float?
  codeQuality              Float?
  aiGeneratedDocs          Json?
  aiImprovementSuggestions Json?
  keyInnovations           Json?
  memberContributions      Json?
  technologyStack          String[]
  problemStatement         String?
  solutionOverview         String?
  technologies             Skill[]              @relation("ProjectTechnologies")
  repositoryUrl            String?
  submissionUrl            String?
  progressUpdates          ProgressUpdate[]     @relation("ProjectProgressUpdates")
  members                  ProjectMember[]
  report                   ProjectReport?
  AIRecommendation         AIRecommendation[]
  GitHubContribution       GitHubContribution[]
  Notification             Notification[]
  SubmissionFeedback       SubmissionFeedback?
  TimelineSuggestion       TimelineSuggestion[]
  ProjectAssessment        ProjectAssessment?
  EventLog                 EventLog[]
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id                 String               @id @default(uuid())
  projectId          String?
  title              String
  description        String
  status             Status               @default(PENDING)
  assigneeId         String?
  priority           TaskPriority         @default(MEDIUM)
  dueDate            DateTime?
  estimatedTime      Float?
  actualTime         Float?
  dependencies       String[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  project            Project?             @relation("ProjectTasks", fields: [projectId], references: [id], onDelete: Cascade)
  assignee           User?                @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  checkList          CheckListItem[]
  comments           Comment[]
  teamId             String
  team               Team                 @relation("TeamTasks", fields: [teamId], references: [id], onDelete: Cascade)
  difficulty         Difficulty           @default(MEDIUM)
  aiSuggestion       Boolean              @default(false)
  AIRecommendation   AIRecommendation[]
  Notification       Notification[]
  TimelineSuggestion TimelineSuggestion[]
  conflictingTask1   TaskConflict[]       @relation("ConflictingTask1")
  conflictingTask2   TaskConflict[]       @relation("ConflictingTask2")
  TaskConflict       TaskConflict[]
  EventLog           EventLog[]
}

model CheckListItem {
  id        String  @id @default(uuid())
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status    String  @default("in-progress")
  rank      Int
  text      String
  completed Boolean @default(false)
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String?
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model ProgressUpdate {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation("UserProgressUpdates", fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation("ProjectProgressUpdates", fields: [projectId], references: [id], onDelete: Cascade)

  @@map("progress_updates")
}

model ProjectReport {
  id        String   @id @default(uuid())
  projectId String   @unique
  content   String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_reports")
}

model ProjectMember {
  userId    String
  projectId String
  role      ProjectRole @default(CONTRIBUTOR)
  joinedAt  DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([userId, projectId])
  @@map("project_members")
}

enum ProjectRole {
  BACKEND_DEVELOPER
  FULLSTACK_DEVELOPER
  FRONTEND_DEVELOPER
  DESIGNER
  RESEARCHER
  CONTRIBUTOR
  PROJECT_MANAGER
  TESTER
}

model TeamMember {
  userId   String
  teamId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([userId, teamId])
  @@map("team_members")
}

enum TeamRole {
  LEADER
  MEMBER
  MENTOR
}

model AIRecommendation {
  id              String                   @id @default(uuid())
  projectId       String
  type            RecommendationType
  content         Json
  createdAt       DateTime                 @default(now())
  userId          String?
  taskId          String?
  confidenceScore Float?
  feedback        RecommendationFeedback[]
  project         Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User?                    @relation("UserRecommendations", fields: [userId], references: [id], onDelete: SetNull)
  task            Task?                    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("ai_recommendations")
}

enum RecommendationType {
  TECHNOLOGY_SUGGESTION
  TASK_ALLOCATION_ADVICE
  RESOURCE_RECOMMENDATION
  BEST_PRACTICE_TIP
  DEBUGGING_HELP
  SUBMISSION_IMPROVEMENT_SUGGESTION
  TIMELINE_ADJUSTMENT_PROPOSAL
  TEAM_FORMATION_SUGGESTION
  MENTORSHIP_SUGGESTION
  CODE_REVIEW_SUGGESTION
}

model RecommendationFeedback {
  id               String           @id @default(uuid())
  recommendationId String
  userId           String
  timestamp        DateTime         @default(now())
  isHelpful        Boolean?
  comment          String?
  recommendation   AIRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recommendation_feedback")
}

model GitHubContribution {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  type      String
  action    String?
  url       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("github_contributions")
}

model NotificationPreference {
  id       String  @id @default(uuid())
  userId   String  @unique
  discord  Boolean @default(false)
  slack    Boolean @default(false)
  telegram Boolean @default(false)
  email    Boolean @default(true)
  settings Json?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  channel   String
  message   String
  sentAt    DateTime @default(now())
  isRead    Boolean  @default(false)
  projectId String?
  taskId    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model SubmissionFeedback {
  id        String   @id @default(uuid())
  projectId String   @unique
  feedback  Json?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("submission_feedback")
}

model Mentorship {
  id        String    @id @default(uuid())
  mentorId  String
  menteeId  String
  startDate DateTime  @default(now())
  endDate   DateTime?
  notes     String?
  mentor    User      @relation("MentorshipsGiven", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee    User      @relation("MentorshipsReceived", fields: [menteeId], references: [id], onDelete: Cascade)
  User      User?     @relation(fields: [userId], references: [id])
  userId    String?

  @@map("mentorships")
}

model TimelineSuggestion {
  id               String    @id @default(uuid())
  projectId        String
  taskId           String?
  suggestedDueDate DateTime?
  reasoning        String?
  createdAt        DateTime  @default(now())
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task             Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("timeline_suggestions")
}

model TaskConflict {
  id                  String    @id @default(uuid())
  task1Id             String
  task2Id             String
  description         String?
  suggestedResolution Json?
  resolved            Boolean   @default(false)
  resolvedAt          DateTime?
  task1               Task      @relation("ConflictingTask1", fields: [task1Id], references: [id], onDelete: Cascade)
  task2               Task      @relation("ConflictingTask2", fields: [task2Id], references: [id], onDelete: Cascade)
  Task                Task?     @relation(fields: [taskId], references: [id])
  taskId              String?

  @@map("task_conflicts")
}

model ProjectAssessment {
  id             String   @id @default(uuid())
  projectId      String   @unique
  readinessScore Float?
  feedback       Json?
  assessedAt     DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_assessments")
}

model EventLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  eventType String
  userId    String?
  projectId String?
  taskId    String?
  details   Json?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("event_logs")
}
