generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  github       String      @unique
  password     String
  bio          String?
  profilePhoto String?
  skills       String[]
  hackathons   Hackathon[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum Status {
  UPCOMING
  ONGOING
  PAST
}

model Hackathon {
  id          String   @id @default(uuid())
  name        String
  description String
  date        DateTime
  domain      String[]
  website     String?
  status      Status   @default(UPCOMING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  User        User?    @relation(fields: [userId], references: [id])
  userId      String?
}
